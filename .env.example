# Hindsight — Cloud endpoint from https://ui.hindsight.vectorize.io dashboard
# (for local OSS install use http://localhost:8888)
HINDSIGHT_BASE_URL=https://your-hindsight-endpoint
HINDSIGHT_API_KEY=your-hindsight-api-key

# Groq — https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# LLM model: openai/gpt-oss-120b (default) or qwen/qwen3-32b
WAADA_LLM_MODEL=openai/gpt-oss-120b
