# Hindsight endpoint: Cloud URL from the Hindsight dashboard, or http://localhost:8888 for local OSS in Docker
HINDSIGHT_BASE_URL=
# Hindsight API key (Cloud); leave empty for a local install without auth
HINDSIGHT_API_KEY=
# Slack bot token (xoxb-...) for the Slack connector (M08a); optional
SLACK_BOT_TOKEN=
# HubSpot private app token for the CRM connector (M08c); optional
HUBSPOT_TOKEN=
# Path to the Google OAuth client credentials JSON for the Gmail connector (M08b); optional
GOOGLE_CREDENTIALS_PATH=
# Folder for local app data (JSON files); relative paths resolve from the repo root
WAADA_DATA_DIR=.waada
# Only for the hosted app; leave empty locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Groq API key (https://console.groq.com/keys). Fallback when no Groq key is saved in Settings → LLM (.waada/llm.json wins).
GROQ_API_KEY=
# Other LLM providers' keys are set in the web app's Settings (stored in .waada/).
